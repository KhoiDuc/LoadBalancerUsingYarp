// =====================================================================
// Cau hinh Load Balancer (YARP). Bo nap cau hinh JSON cua .NET cho phep
// comment "//" va dau phay thua, nen file nay van doc duoc binh thuong.
// Doi gia tri roi luu -> YARP tu hot-reload (khong can restart).
// =====================================================================
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // De "Information" de thay log YARP dinh tuyen request vao node nao.
      // Doi thanh "Warning" neu muon log gon hon.
      "Yarp": "Information"
    }
  },

  // Luong load balancing. Doc boi LoadBalancerModeConfigFilter.cs.
  //   "Stateless" = RoundRobin thuan, KHONG session affinity (khuyen nghi khi da share state qua Redis).
  //   "Affinity"  = RoundRobin + sticky cookie (moi user "dinh" 1 node).
  "LoadBalancer": {
    "Mode": "Stateless"
  },

  // Cau hinh reverse proxy cua YARP: Routes (dinh tuyen URL) + Clusters (nhom backend).
  "ReverseProxy": {
    "Routes": {
      // Route test Rate Limiting: Co ap dung chinh sach gioi han tan suat 5 req/10s
      "ratelimit-demo": {
        "ClusterId": "demo",
        "Order": 1,
        "RateLimiterPolicy": "demo-limiter",
        "Match": { "Path": "/api/test-ratelimit" }
      },
      // 1 route ten "demo": bat MOI duong dan va day vao cluster "demo".
      "demo": {
        "ClusterId": "demo",
        "Order": 100,
        "Match": { "Path": "{**catch-all}" }
      }
    },
    "Clusters": {
      "demo": {
        "HealthCheck": {
          // ACTIVE: LB tu dong goi /health dinh ky de biet node song/chet (1s kiem tra 1 lan).
          "Active": {
            "Enabled": true,
            "Interval": "00:00:01", // Kiem tra moi 1 giay de phat hien su co tuc thi
            "Timeout": "00:00:01",  // Qua 1 giay khong phan hoi coi nhu loi
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          },
          // PASSIVE: Quan sat cac request that, bat loi HTTP 5xx (vi du 503) de loai node ngay lap tuc.
          "Passive": {
            "Enabled": true,
            "Policy": "FailOn5xx",             // Chinh sach tu che: 5xx = Unhealthy ngay
            "ReactivationPeriod": "00:00:15"    // sau 15 giay thu dua node loi tro lai
          }
        },
        // Tham so cho cac health policy o tren.
        "Metadata": {
          // ConsecutiveFailures: chi can 1 lan loi la loai bo ngay lap tuc
          "ConsecutiveFailuresHealthPolicy.Threshold": "1"
        },
        // Danh sach backend that. Doi Address sang node1/node2 cua project cua ban
        // khi muon tai su dung LB cho app khac (khong can sua code).
        //
        // >> DUNG "127.0.0.1" thay vi "localhost": tren Windows "localhost" hay phan giai
        //    ra IPv6 "::1" TRUOC. Khi setup IIS SERVER, node bind vao 127.0.0.1 (chi IPv4),
        //    neu de "localhost" thi YARP goi vao ::1 -> khong toi duoc node. Dung 127.0.0.1
        //    chay dung cho CA local (node bind '*') lan server (node bind '127.0.0.1').
        "Destinations": {
          "node1": { "Address": "http://127.0.0.1:5001/" },
          "node2": { "Address": "http://127.0.0.1:5002/" }
        }
      }
    }
  }
}
